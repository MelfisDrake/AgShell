<Project>
  <Target Name="PinAgShellReleaseRuntime" BeforeTargets="ProcessFrameworkReferences" Condition="'$(AgShellReleaseRuntimeVersion)' != ''">
    <ItemGroup>
      <KnownFrameworkReference Update="Microsoft.NETCore.App;Microsoft.WindowsDesktop.App;Microsoft.WindowsDesktop.App.WPF;Microsoft.WindowsDesktop.App.WindowsForms"
                               Condition="'%(TargetFramework)' == 'net10.0'"
                               LatestRuntimeFrameworkVersion="$(AgShellReleaseRuntimeVersion)" />
      <KnownRuntimePack Update="Microsoft.NETCore.App" Condition="'%(TargetFramework)' == 'net10.0'"
                        LatestRuntimeFrameworkVersion="$(AgShellReleaseRuntimeVersion)" />
      <KnownAppHostPack Update="Microsoft.NETCore.App" Condition="'%(TargetFramework)' == 'net10.0'"
                        AppHostPackVersion="$(AgShellReleaseRuntimeVersion)" />
      <KnownILCompilerPack Update="Microsoft.DotNet.ILCompiler" Condition="'%(TargetFramework)' == 'net10.0'"
                           ILCompilerPackVersion="$(AgShellReleaseRuntimeVersion)" />
      <KnownILLinkPack Update="Microsoft.NET.ILLink.Tasks" Condition="'%(TargetFramework)' == 'net10.0'"
                       ILLinkPackVersion="$(AgShellReleaseRuntimeVersion)" />
    </ItemGroup>
  </Target>
</Project>
