<Window x:Class="AgShell.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="AgShell"
        Width="1100"
        Height="700"
        MinWidth="640"
        MinHeight="400"
        Background="#1B1A18">
    <Window.Template><ControlTemplate TargetType="Window"><ContentPresenter /></ControlTemplate></Window.Template>
    <Grid x:Name="chromeFrame">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="chromeRow" Height="30" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid x:Name="chromeHeader">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition x:Name="captionReserve" Width="150" /></Grid.ColumnDefinitions>
            <Border x:Name="captionPaint" Grid.Column="1" />
            <Border x:Name="identityBackground">
                <Grid x:Name="identityLayout" Margin="12,0">
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="identityLeading" Width="0" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel x:Name="identityText" Grid.Column="1" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" MaxWidth="240" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="identityTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <DockPanel x:Name="identityHostGroup" Grid.Column="1" Opacity="0.6" Margin="6,0,0,0">
                                <Path Width="14" Height="14" Margin="0,0,4,0" Stretch="Uniform" VerticalAlignment="Center" Stroke="{Binding Foreground, ElementName=identityHost}" StrokeThickness="1.5"
                                      Data="M4.5 12.5h7.25a2.75 2.75 0 0 0 .3-5.48A4 4 0 0 0 4.3 7.6 2.5 2.5 0 0 0 4.5 12.5z" />
                                <TextBlock x:Name="identityHost" />
                            </DockPanel>
                            <TextBlock x:Name="identityContext" Grid.Column="2" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <TextBlock x:Name="identitySubtitle" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel x:Name="chromeActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" />
                    <Grid x:Name="chromeSidebarHost" />
                </Grid>
            </Border>
        </Grid>
        <!-- agterm's menu bar, in the window: Windows has no menu bar of the app. Its menus are the system's popup menus.
             It holds its place from the start, so the terminals are not laid out for a taller window before the menus come. -->
        <Border x:Name="menuBarHost" Grid.Row="1" Visibility="Hidden" Padding="4,2">
            <StackPanel x:Name="menuBar" Orientation="Horizontal" />
        </Border>
        <Border x:Name="resizeEdgePaint" Grid.Row="2" IsHitTestVisible="False" />
        <wv2:WebView2 x:Name="webView" Grid.Row="2" />
        <!-- Web pages shown in overlays live in their own browsers here, placed where the page leaves room for them. -->
        <Canvas x:Name="pageLayer" Grid.Row="2" />
    </Grid>
</Window>
